{
  "root": true,
  "ignorePatterns": ["dist/**", ".next/**"],
  "plugins": ["import", "unused-imports"],
  "overrides": [
    {
      "files": "*.json",
      "parser": "jsonc-eslint-parser",
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      // Mirror Nx's TypeScript preset behavior while using the upstream @typescript-eslint ruleset.
      "extends": ["plugin:@typescript-eslint/recommended"],
      "rules": {
        // ----- Nx-aligned overrides (start) -----
        "@typescript-eslint/adjacent-overload-signatures": "error",
        "@typescript-eslint/explicit-function-return-type": "off",
        "@typescript-eslint/explicit-member-accessibility": "off",
        "no-inner-declarations": "off",
        "prefer-const": "off",
        "@typescript-eslint/explicit-module-boundary-types": "error",
        "@typescript-eslint/no-namespace": "off",
        "@typescript-eslint/no-this-alias": [
          "error",
          {
            "allowedNames": ["self"]
          }
        ],
        "@typescript-eslint/no-parameter-properties": "off",
        "@typescript-eslint/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "disallowTypeAnnotations": true,
            "prefer": "type-imports",
            "fixStyle": "inline-type-imports"
          }
        ],
        "@typescript-eslint/no-explicit-any": "warn",
        "@typescript-eslint/no-non-null-assertion": "warn",
        "@typescript-eslint/no-require-imports": "off",
        "@typescript-eslint/prefer-namespace-keyword": "error",
        // ----- Nx-aligned overrides (end) -----

        "@typescript-eslint/no-empty-interface": "off",
        "@typescript-eslint/no-inferrable-types": "off", // Allow inferrable types
        "@typescript-eslint/no-unused-vars": "off", // Handled by unused-imports plugin
        "unused-imports/no-unused-imports": "error",
        "@typescript-eslint/no-empty-function": "off", // Allow no-op functions
        "import/no-relative-packages": "error",
        "@next/next/no-img-element": "off"
      }
    },
    {
      "files": ["*.spec.ts", "*.spec.tsx", "*.test.ts", "*.test.tsx", "**/test-utils.ts"],
      "env": {
        "jest": true
      },
      "rules": {
        "@typescript-eslint/no-non-null-assertion": "off",
        "@typescript-eslint/no-require-imports": "off"
      }
    }
  ]
}
