{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "//#format:check": {
      "outputs": []
    },
    "build": {
      "outputs": ["dist/**", ".next/**"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "../../.eslintignore", "../../.eslintrc.json"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"]
    },
    "secrets:pull": {
      "cache": false
    },
    "deno:install": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "check": {
      "outputs": []
    },
    "dev:databases": {
      "cache": false
    },
    "dev:desktop": {
      "cache": false,
      "persistent": true
    },
    "dev:standalone": {
      "cache": false,
      "persistent": true
    },
    "@bitcoin-control-center/shared#test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.oxlintrc*.json",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/apps/control-center/src/**/*.test.*"
      ],
      "outputs": ["coverage/**"]
    }
  }
}
