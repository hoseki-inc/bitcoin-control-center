# api-sentinel — local-first Bitcoin backend
# Copy to .env and fill in your values.

# Server
HOST=localhost
PORT=3400

# Electrum server connection (required)
# `pnpm dev:desktop` saves this as its first connection, then uses its saved connections.
ELECTRUM_HOST=127.0.0.1
ELECTRUM_PORT=50001
ELECTRUM_PROTOCOL=tcp

# Bitcoin network: mainnet or testnet
BITCOIN_NETWORK=mainnet

# Directory for SQLite database and generated files
DATA_DIR=./data

# Logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Development only (`pnpm dev`): slow every Electrum request the way Tor does, to review
# loading states. requestMs,jitterMs,connectMs,failureRate, such as 800,400,8000,0.02.
# SENTINEL_DEV_ELECTRUM_LATENCY=
