{
  "name": "bitcoin-control-center",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:ci": "pnpm build && npm --prefix start9 run build && pnpm build:desktop:app",
    "build:desktop": "./desktop/build.sh",
    "build:desktop:app": "pnpm --filter api-sentinel build && pnpm --filter control-center build --mode production.desktop && tsx desktop/src/scripts/build.ts",
    "build:start9": "./start9/build.sh",
    "check": "tsc --build tsconfig.check.json",
    "ci": "pnpm security:audit && pnpm format:check && pnpm lint && pnpm check && npm --prefix desktop run check && npm --prefix start9 run check && pnpm test && npm --prefix start9 test && pnpm build:ci",
    "dev": "turbo run dev:standalone --filter=api-sentinel --filter=control-center",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ladle:build": "ladle build",
    "ladle:serve": "ladle serve",
    "lint": "oxlint --deny-warnings . && turbo run lint -- --max-warnings=0",
    "lint:oxlint": "oxlint --deny-warnings .",
    "prepare": "husky install",
    "security:audit": "pnpm audit --audit-level=moderate && npm --prefix desktop audit --audit-level=moderate && npm --prefix start9 audit --audit-level=moderate && npm --prefix start9/runtime audit --audit-level=moderate",
    "test": "turbo run test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "prettier --write"
    ]
  },
