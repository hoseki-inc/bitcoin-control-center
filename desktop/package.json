    "install:electron": "node node_modules/electron/install.js",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@react-pdf/renderer": "4.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "overrides": {
    "global-agent": "4.1.3",
    "http-cache-semantics": "4.3.0"
  }
}
