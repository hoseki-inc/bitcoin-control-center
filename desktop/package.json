{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Bitcoin portfolio tracking and proof-of-reserves statements",
  "repository": "https://github.com/hoseki-inc/bitcoin-control-center",
  "license": "Apache-2.0",
  "author": "Hoseki, Inc.",
  "main": "app/main/index.js",
  "scripts": {
    "check": "tsc --noEmit && vitest run",
    "dev": "electron app/main/index.js",
    "dist:mac": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win",
    "install:electron": "node node_modules/electron/install.js",
    "rebuild": "node -e \"const Database = require('better-sqlite3'); const database = new Database(':memory:'); database.close()\"",
    "test:runtime": "node scripts/check-runtime.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "better-sqlite3": "13.0.3",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yoga-layout": "3.2.1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  }
}
